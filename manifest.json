function doGet(e) {
  var lock = LockService.getPublicLock();
  lock.waitLock(10000); 

  try {
    if (!e || !e.parameter || !e.parameter.action) {
      return ContentService.createTextOutput("Error: Missing parameters.");
    }

    var data = e.parameter;
    var action = data.action;

    if (action === "bookClass") {
      var sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Bookings");
      
      if (!sheet) {
        sheet = SpreadsheetApp.getActiveSpreadsheet().insertSheet("Bookings");
        // Added Member Name column to the baseline header template
        sheet.appendRow(["Booking ID", "Member ID", "Class Name", "Date/Time", "Email", "Member Name"]);
      }

      var bookingId = "BK-" + Date.now();
      var timestamp = new Date().toLocaleString();

      // Write parameters directly into your columns (Adding data.name at the end)
      sheet.appendRow([
        bookingId, 
        data.memberId, 
        data.className, 
        timestamp,
        data.email,
        data.name 
      ]);
      
      SpreadsheetApp.flush(); 
    }
    
    return ContentService.createTextOutput("Success");

  } catch(error) {
    return ContentService.createTextOutput("Backend Error: " + error.toString());
  } finally {
    lock.releaseLock(); 
  }
}
